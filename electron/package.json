{
  "name": "subcio-desktop",
  "version": "1.0.1",
  "description": "Subcio - AI Karaoke Subtitle Editor",
  "main": "main.js",
  "author": "Subcio Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run start:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "start:frontend": "cd ../frontend && npm run dev",
    "prepare-python": "node scripts/prepare-python.js",
    "prebuild": "node build.js",
    "build": "electron-builder --win",
    "build:nsis": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:mac-x64": "electron-builder --mac --x64",
    "build:mac-arm64": "electron-builder --mac --arm64",
    "build:mac-universal": "electron-builder --mac --x64 && electron-builder --mac --arm64",
    "build:mac-dir": "electron-builder --mac --dir",
    "build:all": "node scripts/build-all.js --all",
    "build:all-mac": "node scripts/build-all.js --mac",
    "pack": "electron-builder --dir",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags",
    "postversion": "echo 'Version bumped to' $(node -p \"require('./package.json').version\")"
  },
  "build": {
    "appId": "com.subcio.app",
    "productName": "Subcio",
    "copyright": "Copyright © 2024 Subcio",
    "asar": true,
    "asarUnpack": [
      "python-embedded/**/*",
      "ffmpeg/**/*",
      "backend/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "license-manager.js",
      "preload.js",
      "assets/**/*",
      "python-embedded/**/*",
      "ffmpeg/**/*",
      "backend/**/*",
      "!backend/**/__pycache__/**",
      "!backend/**/venv/**",
      "!backend/**/.env",
      "frontend-dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Subcio",
      "installerSidebar": "assets/installerSidebar.png",
      "installerHeader": "assets/installerHeader.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Please allow access to the microphone to use audio features.",
        "NSCameraUsageDescription": "Please allow access to the camera to use video features."
      }
    },
    "dmg": {
      "background": "assets/dmg-background.png",
      "icon": "assets/icon.icns",
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "subcio",
      "repo": "subcio-desktop"
    }
  },
  "dependencies": {
    "electron-log": "^5.0.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  }
}
